# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요. .env.local 은 git에서 제외되며 서버 PC에만 둡니다.
# Supabase 값은 `npx supabase status -o env` 로 확인합니다 (API_URL, ANON_KEY, SERVICE_ROLE_KEY, DB_URL).

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
# 계정 추가·삭제와 이전 계정 이전에만 쓰는 서버 전용 키. 절대 브라우저로 보내지 않습니다.
SUPABASE_SERVICE_ROLE_KEY=
# 데이터 이전·백업 스크립트용
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# 하이웍스 메일(SMTP). 하이웍스 관리자 설정에서 외부 메일 프로그램(SMTP) 사용이 허용되어 있어야 합니다.
HIWORKS_SMTP_HOST=smtps.hiworks.com
HIWORKS_SMTP_PORT=465
HIWORKS_SMTP_USER=
HIWORKS_SMTP_PASSWORD=
HIWORKS_SENDER_NAME=관리팀
