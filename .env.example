# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요. .env.local 은 git에서 제외되며 서버 PC에만 둡니다.
# DB는 Supabase(Postgres + 로그인)를 씁니다. 브라우저는 Supabase에 직접 접속하지 않고 이 서버(Next.js)만 거칩니다.
# 그래서 NEXT_PUBLIC_ 이 붙은 변수는 없습니다 (키가 브라우저로 나가지 않음).

# ------------------------------------------------------------------ Supabase
# [A] 서버 PC에서 직접 돌리는 Supabase (지금 쓰는 방식, Docker 필요)
#     1) npm run db:start        → Supabase 켜기 (supabase/config.toml, project_id = caps-attendance-app)
#     2) npx supabase status -o env → 아래 값 확인
#        API_URL → SUPABASE_URL / ANON_KEY → SUPABASE_ANON_KEY / SERVICE_ROLE_KEY → SUPABASE_SERVICE_ROLE_KEY / DB_URL → SUPABASE_DB_URL
#     (status에 나오는 PUBLISHABLE_KEY·SECRET_KEY는 새 이름의 키입니다. 이 앱은 ANON_KEY·SERVICE_ROLE_KEY를 씁니다.)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
# 서버 전용 관리자 키 (계정 추가·삭제, 입찰 공고 자동 저장에 씀). RLS를 건너뛰므로 절대 밖으로 보내지 않습니다.
SUPABASE_SERVICE_ROLE_KEY=
# Postgres 직접 접속 주소 (데이터 이전 스크립트용). DB 백업(npm run db:backup)은 Docker 컨테이너
# supabase_db_caps-attendance-app 에서 pg_dump로 받으므로 [A] 방식에서만 동작합니다.
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# [B] supabase.com 클라우드 프로젝트를 쓸 때는 위 네 줄을 이렇게 바꿉니다
#     (대시보드 → Project Settings → API / Database → Connection string)
#     DB 구조는 npx supabase link --project-ref <프로젝트ID> 후 npx supabase db push 로 올립니다.
# SUPABASE_URL=https://<프로젝트ID>.supabase.co
# SUPABASE_ANON_KEY=<anon public 키>
# SUPABASE_SERVICE_ROLE_KEY=<service_role 키>
# SUPABASE_DB_URL=postgresql://postgres.<프로젝트ID>:<DB 비밀번호>@aws-0-<지역>.pooler.supabase.com:5432/postgres

# ------------------------------------------------------------------ 직원 개인정보 암호화
# 주민등록번호 암호화 키: 32바이트를 base64로 (44글자). 잃어버리면 저장된 주민번호를 못 읽으니 따로 보관하세요.
# 만들기: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
EMP_SECRET_KEY=

# ------------------------------------------------------------------ 하이웍스 메일(SMTP)
# 하이웍스 관리자 설정에서 외부 메일 프로그램(SMTP) 사용이 허용되어 있어야 합니다. 비워 두면 메일 보내기가 꺼집니다.
HIWORKS_SMTP_HOST=smtps.hiworks.com
HIWORKS_SMTP_PORT=465
HIWORKS_SMTP_USER=
HIWORKS_SMTP_PASSWORD=
HIWORKS_SENDER_NAME=관리팀

# ------------------------------------------------------------------ 입찰 공고 자동 불러오기
# 감시기(자동실행/run-server.mjs)가 /api/bid/fetch 를 부를 때 쓰는 암호. 아무 긴 글자나 정해 넣으세요.
# 만들기: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
BID_CRON_KEY=
# 공공데이터포털(data.go.kr) 일반 인증키(Decoding). 비워 두면 공고 자동 불러오기를 건너뜁니다.
DATA_GO_KR_KEY=
